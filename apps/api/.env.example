NODE_ENV="development"
PORT="3000"
DATABASE_URL="postgresql://bookleaf:bookleaf@localhost:5432/bookleaf?schema=public"
SESSION_COOKIE_NAME="bookleaf_session"
CSRF_COOKIE_NAME="bookleaf_csrf"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="replace-with-a-long-random-secret-of-32-chars-or-more"
SESSION_TTL_HOURS="168"
WEB_ORIGIN="http://localhost:5173"
# Set to a hop count (e.g. 1) when running behind a reverse proxy so req.ip and Secure cookies are correct.
TRUST_PROXY="false"
LOGIN_MAX_FAILURES="10"
LOGIN_FAILURE_WINDOW_MINUTES="15"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
