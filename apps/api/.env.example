# Copy to apps/api/.env for local development. Real environments inject these variables directly. Never commit real values.
NODE_ENV="development"
PORT="3000"

# PostgreSQL 16+. The database MUST be UTF8 (the API refuses to start otherwise): CREATE DATABASE bookleaf ENCODING 'UTF8' TEMPLATE template0;
DATABASE_URL="postgresql://bookleaf:bookleaf@localhost:5432/bookleaf?schema=public"

# --- Sessions and CSRF ---
SESSION_COOKIE_NAME="bookleaf_session"
# The frontend reads XSRF-TOKEN, csrfToken or _csrf from document.cookie and echoes it in X-CSRF-Token.
CSRF_COOKIE_NAME="XSRF-TOKEN"
# At least 32 characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Placeholder values are rejected in production.
SESSION_SECRET="replace-with-a-long-random-secret-of-32-chars-or-more"
SESSION_TTL_HOURS="168"
# The exact browser origin of the web app (scheme + host + port, no path). https is required in production.
WEB_ORIGIN="http://localhost:5173"
# Hop count (e.g. 1) when behind a reverse proxy, so req.ip (rate limits) and Secure cookies are correct.
TRUST_PROXY="false"

# --- Throttling (in-memory, per API process) ---
LOGIN_MAX_FAILURES="10"
LOGIN_FAILURE_WINDOW_MINUTES="15"
TICKET_CREATE_LIMIT_PER_HOUR="30"
AUTHOR_REPLY_LIMIT_PER_HOUR="60"

# --- Attachments (local disk). Keep outside any web-served path; back it up with the database. ---
ATTACHMENT_DIR="var/attachments"
ATTACHMENT_MAX_BYTES="5242880"
ATTACHMENT_MAX_PER_TICKET="5"

# --- AI (read by @bookleaf/ai once it is merged; see its README). Missing or invalid values never block tickets:
# analyses are recorded as FAILED / AI_NOT_CONFIGURED and admins work manually. ---
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_FALLBACK_MODEL=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
AI_TIMEOUT_MS="15000"
AI_MAX_RETRIES="2"
AI_RETRY_BASE_DELAY_MS="500"
AI_RETRY_MAX_DELAY_MS="4000"
AI_MAX_OUTPUT_TOKENS="400"
