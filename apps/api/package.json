    "helmet": "^8.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "supertest": "^7.1.0",
    "tsx": "^4.19.3",
    "vitest": "^3.0.8"
