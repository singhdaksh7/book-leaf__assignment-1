# Example only: NOT installed anywhere. Copy to /etc/cron.d/bookleaf-backup after the owner approves host changes.
# Daily 02:30 UTC backup; weekly (Monday 03:30 UTC) isolated restore test.
# /root/.bookleaf-backup-pass must be chmod 600; keep a copy of the passphrase OFF the server or the backups cannot be decrypted.
30 2 * * * root BACKUP_PASSPHRASE_FILE=/root/.bookleaf-backup-pass /opt/bookleaf/src/infra/scripts/backup.sh >> /var/log/bookleaf-backup.log 2>&1
30 3 * * 1 root BACKUP_PASSPHRASE_FILE=/root/.bookleaf-backup-pass /opt/bookleaf/src/infra/scripts/restore-test.sh >> /var/log/bookleaf-backup.log 2>&1
