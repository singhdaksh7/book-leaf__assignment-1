# Copy to infra/.env on the server (chmod 600). Never commit the filled-in file.
# Public hostname served by the existing Traefik. sslip.io resolves <name>.<ip>.sslip.io to <ip>, and Let's Encrypt issues a real certificate.
BOOKLEAF_HOST=bookleaf.77.37.45.177.sslip.io
BOOKLEAF_TAG=local
# Optional: pin the web image separately from the API (used for frontend-only releases and rollback)
#BOOKLEAF_WEB_TAG=

# Generate each with: openssl rand -hex 24   (hex keeps DATABASE_URL valid)
POSTGRES_PASSWORD=
# At least 32 characters and not a placeholder (the API refuses placeholders in production)
SESSION_SECRET=

# Synthetic demo accounts (seed job only). Passwords must be at least 12 characters.
BOOKLEAF_SEED_AUTHOR_PASSWORD=
BOOKLEAF_SEED_ADMIN_EMAIL=admin@example.test
BOOKLEAF_SEED_ADMIN_PASSWORD=

# Leave empty: AI then records AI_NOT_CONFIGURED and no paid calls are made. Set only with explicit approval.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# Leave unset in any real deployment (default https://openrouter.ai/api/v1). Only infra/docker-compose.demo.yml sets it (opt-in demo), to
# http://127.0.0.1:8080/api/v1 (see DEPLOY.md). The AI package accepts plain http solely for 127.0.0.1/localhost.
#OPENROUTER_BASE_URL=
