flowchart LR
    DEV["Workstation<br/>git checkout of a commit"] -->|"docker build<br/>infra/docker/api.Dockerfile<br/>infra/docker/web.Dockerfile"| IMG["images bookleaf-api:TAG<br/>bookleaf-web:TAG"]
