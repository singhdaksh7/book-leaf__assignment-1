# Names and safe defaults only. Set real values in the API server's environment; never commit them.
# Server-side only: never expose to apps/web or put in a VITE_* variable.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Optional: tried once, only after the primary model fails with a retryable error.
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_NAME=BookLeaf Author Support Portal
OPENROUTER_APP_URL=
AI_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
AI_RETRY_BASE_DELAY_MS=500
AI_RETRY_MAX_DELAY_MS=4000
AI_MAX_OUTPUT_TOKENS=400
