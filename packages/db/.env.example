DATABASE_URL="postgresql://bookleaf:bookleaf@localhost:5432/bookleaf?schema=public"

# Seed credentials (used only by `npm run seed` / `seed:synthetic`; never part of the dataset). Minimum 12 characters.
BOOKLEAF_SEED_AUTHOR_PASSWORD=""
BOOKLEAF_SEED_ADMIN_EMAIL=""
BOOKLEAF_SEED_ADMIN_PASSWORD=""
# Optional: path to the confidential dataset (default data/bookleaf_sample_data.json). Set to 1 to deliberately reset existing passwords.
BOOKLEAF_SEED_DATA_PATH=""
BOOKLEAF_SEED_RESET_PASSWORDS=""
